# --- 数据：绝不要提交数据集 ---
# 注意：必须用前导斜杠锚定到仓库根目录。
# 写 "data/" 会匹配任意层级的同名目录，把 recagent/data/ 这个代码包也一起忽略掉。
/data/
!/data/.gitkeep
*.csv
*.tsv
*.zip
*.gz
*.parquet
*.h5
*.npz
*.pkl

# --- 模型权重与产物：绝不要提交 ---
checkpoints/
outputs/
runs/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.gguf
models/

